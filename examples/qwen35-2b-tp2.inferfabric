language inferfabric 1;

model Qwen35 {
    contract = qwen35_text_v1;
    label = "Qwen3.5-2B-text";
    hidden = 2048;
    intermediate = 6144;
    vocab = 248320;
    query_heads = 8;
    kv_heads = 2;
    head_dim = 256;
    delta_heads = 16;
    delta_dim = 128;
    conv_width = 4;
    layers = [delta, delta, delta, full, delta, delta, delta, full, delta, delta, delta, full, delta, delta, delta, full, delta, delta, delta, full, delta, delta, delta, full];
}

plan Local for Qwen35 {
    prefill = mesh(tp = 2, cp = 1, sp = false);
    decode = mesh(tp = 2, cp = 1, sp = false);
    page_tokens = 128;
    token_budget = 1024;
    batch_buckets = [1, 2, 4, 8];
    context_buckets = [128, 512, 2048, 8192];
}
