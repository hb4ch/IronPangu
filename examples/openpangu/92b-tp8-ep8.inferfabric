    let l42_qa = linear(l42_an, weight = "model.layers.42.self_attn.q_a_proj", width = 1024, placement = "replicated");
    let l42_qc = mome(l42_qa, weight = "model.layers.42.self_attn.qa_conv", taps = 3);
    let l42_qn = norm(l42_qc, weight = "model.layers.42.self_attn.q_a_layernorm", eps = 1e-5);
