language inferfabric 1;

// Complete token dataflow. No model contract selects a hidden decoder.
// Expanded SSA deliberately makes every layer, collective and binding inspectable.
// ascend_token_v1: one sequence, one token, exact causal candidates <=512.
model OpenPangu92B {
    context = 512;
    eos = 148902;
    let embedding = embedding(weight = "model.embed_tokens", width = 2560, vocab = 151552);
    let streams = repeat(embedding, count = 4);

    // Layer 0: dense FFN.
    let l0_hc = mhc_pre(streams, weight = "model.layers.0.attn_mhc_module", streams = 4, sinkhorn = 20, eps = 1e-6);
    let l0_hin = mhc_input(l0_hc);
    let l0_an = norm(l0_hin, weight = "model.layers.0.input_layernorm", eps = 1e-5);
    let l0_qa = linear(l0_an, weight = "model.layers.0.self_attn.q_a_proj", width = 1024, placement = "replicated");
    let l0_qc = mome(l0_qa, weight = "model.layers.0.self_attn.qa_conv", taps = 3);
    let l0_qn = norm(l0_qc, weight = "model.layers.0.self_attn.q_a_layernorm", eps = 1e-5);
    let l0_q_local = linear(l0_qn, weight = "model.layers.0.self_attn.q_b_proj", width = 1152, placement = "tp_rows");
    let l0_q = gather(l0_q_local);
    let l0_kv = linear(l0_an, weight = "model.layers.0.self_attn.kv_a_proj_with_mqa", width = 576, placement = "replicated");
    let l0_latent = slice(l0_kv, start = 0, width = 512);
    let l0_kr = slice(l0_kv, start = 512, width = 64);
    let l0_kc = mome(l0_latent, weight = "model.layers.0.self_attn.compresskv_conv", taps = 3);
    let l0_kn = norm(l0_kc, weight = "model.layers.0.self_attn.kv_a_layernorm", eps = 1e-5);
    let l0_rot = rope(l0_kr, theta = 6400000);
    let l0_key = concat(l0_kn, l0_rot);
    let l0_sink = sink_normalize(weight = "model.layers.0.self_attn", norm = "model.layers.0.self_attn.kv_a_layernorm", count = 128, latent = 512, rope = 64, eps = 1e-5);
    let l0_cache = cache_append(l0_key, l0_sink);
    let l0_query = mla_query(l0_q, weight = "model.layers.0.self_attn.kv_b_proj", theta = 6400000, heads = 48, nope = 128, rope = 64, latent = 512);
    let l0_att = latent_attention(l0_query, l0_cache, scale_dim = 192, window = 2048, selection = "all_causal_within_window");
    let l0_value = mla_value(l0_att, weight = "model.layers.0.self_attn.kv_b_proj", heads = 48, latent = 512, value = 128);
    let l0_vg = gather(l0_value);
    let l0_oc = mome(l0_vg, weight = "model.layers.0.self_attn.o_conv", taps = 3);
    let l0_ao_local = linear(l0_oc, weight = "model.layers.0.self_attn.o_proj", width = 320, placement = "tp_rows");
    let l0_ao = gather(l0_ao_local);
    let l0_apn = norm(l0_ao, weight = "model.layers.0.post_attention_layernorm", eps = 1e-5);
    let l0_res = mhc_post(l0_hc, l0_apn);
    let l0_fhc = mhc_pre(l0_res, weight = "model.layers.0.mlp_mhc_module", streams = 4, sinkhorn = 20, eps = 1e-6);
    let l0_fin = mhc_input(l0_fhc);
    let l0_fn = norm(l0_fin, weight = "model.layers.0.pre_mlp_layernorm", eps = 1e-5);
    let l0_ff_gate_local = linear(l0_fn, weight = "model.layers.0.mlp.gate_proj", width = 1152, placement = "tp_rows");
    let l0_ff_gate = gather(l0_ff_gate_local);
    let l0_ff_up_local = linear(l0_fn, weight = "model.layers.0.mlp.up_proj", width = 1152, placement = "tp_rows");
    let l0_ff_up = gather(l0_ff_up_local);
    let l0_ff_act = swiglu(l0_ff_gate, l0_ff_up);
    let l0_ff_local = linear(l0_ff_act, weight = "model.layers.0.mlp.down_proj", width = 320, placement = "tp_rows");
    let l0_ff = gather(l0_ff_local);
    let l0_fpn = norm(l0_ff, weight = "model.layers.0.post_mlp_layernorm", eps = 1e-5);
    let l0_post = mhc_post(l0_fhc, l0_fpn);
    let l0_out = optional_norm(l0_post, weight = "model.layers.0.block_post_layernorm", eps = 1e-5);

    // Layer 1: dense FFN.
    let l1_hc = mhc_pre(l0_out, weight = "model.layers.1.attn_mhc_module", streams = 4, sinkhorn = 20, eps = 1e-6);
    let l1_hin = mhc_input(l1_hc);
    let l1_an = norm(l1_hin, weight = "model.layers.1.input_layernorm", eps = 1e-5);
    let l1_qa = linear(l1_an, weight = "model.layers.1.self_attn.q_a_proj", width = 1024, placement = "replicated");
    let l1_qc = mome(l1_qa, weight = "model.layers.1.self_attn.qa_conv", taps = 3);
    let l1_qn = norm(l1_qc, weight = "model.layers.1.self_attn.q_a_layernorm", eps = 1e-5);
    let l1_q_local = linear(l1_qn, weight = "model.layers.1.self_attn.q_b_proj", width = 1152, placement = "tp_rows");
    let l1_q = gather(l1_q_local);
    let l1_kv = linear(l1_an, weight = "model.layers.1.self_attn.kv_a_proj_with_mqa", width = 576, placement = "replicated");
    let l1_latent = slice(l1_kv, start = 0, width = 512);
    let l1_kr = slice(l1_kv, start = 512, width = 64);
    let l1_kc = mome(l1_latent, weight = "model.layers.1.self_attn.compresskv_conv", taps = 3);
    let l1_kn = norm(l1_kc, weight = "model.layers.1.self_attn.kv_a_layernorm", eps = 1e-5);
    let l1_rot = rope(l1_kr, theta = 6400000);
    let l1_key = concat(l1_kn, l1_rot);
    let l1_sink = sink_normalize(weight = "model.layers.1.self_attn", norm = "model.layers.1.self_attn.kv_a_layernorm", count = 128, latent = 512, rope = 64, eps = 1e-5);
    let l1_cache = cache_append(l1_key, l1_sink);
    let l1_query = mla_query(l1_q, weight = "model.layers.1.self_attn.kv_b_proj", theta = 6400000, heads = 48, nope = 128, rope = 64, latent = 512);
    let l1_att = latent_attention(l1_query, l1_cache, scale_dim = 192, window = 512, selection = "all_causal_within_window");
    let l1_value = mla_value(l1_att, weight = "model.layers.1.self_attn.kv_b_proj", heads = 48, latent = 512, value = 128);
    let l1_vg = gather(l1_value);
    let l1_oc = mome(l1_vg, weight = "model.layers.1.self_attn.o_conv", taps = 3);
    let l1_ao_local = linear(l1_oc, weight = "model.layers.1.self_attn.o_proj", width = 320, placement = "tp_rows");
    let l1_ao = gather(l1_ao_local);
    let l1_apn = norm(l1_ao, weight = "model.layers.1.post_attention_layernorm", eps = 1e-5);
    let l1_res = mhc_post(l1_hc, l1_apn);
    let l1_fhc = mhc_pre(l1_res, weight = "model.layers.1.mlp_mhc_module", streams = 4, sinkhorn = 20, eps = 1e-6);
    let l1_fin = mhc_input(l1_fhc);
    let l1_fn = norm(l1_fin, weight = "model.layers.1.pre_mlp_layernorm", eps = 1e-5);
    let l1_ff_gate_local = linear(l1_fn, weight = "model.layers.1.mlp.gate_proj", width = 1152, placement = "tp_rows");
    let l1_ff_gate = gather(l1_ff_gate_local);
    let l1_ff_up_local = linear(l1_fn, weight = "model.layers.1.mlp.up_proj", width = 1152, placement = "tp_rows");
    let l1_ff_up = gather(l1_ff_up_local);
    let l1_ff_act = swiglu(l1_ff_gate, l1_ff_up);
    let l1_ff_local = linear(l1_ff_act, weight = "model.layers.1.mlp.down_proj", width = 320, placement = "tp_rows");
    let l1_ff = gather(l1_ff_local);
    let l1_fpn = norm(l1_ff, weight = "model.layers.1.post_mlp_layernorm", eps = 1e-5);
    let l1_post = mhc_post(l1_fhc, l1_fpn);
    let l1_out = optional_norm(l1_post, weight = "model.layers.1.block_post_layernorm", eps = 1e-5);

    // Layer 2: 256 experts, top 8, EP8 + shared expert.
    let l2_hc = mhc_pre(l1_out, weight = "model.layers.2.attn_mhc_module", streams = 4, sinkhorn = 20, eps = 1e-6);
    let l2_hin = mhc_input(l2_hc);
    let l2_an = norm(l2_hin, weight = "model.layers.2.input_layernorm", eps = 1e-5);
    let l2_qa = linear(l2_an, weight = "model.layers.2.self_attn.q_a_proj", width = 1024, placement = "replicated");
    let l2_qc = mome(l2_qa, weight = "model.layers.2.self_attn.qa_conv", taps = 3);
    let l2_qn = norm(l2_qc, weight = "model.layers.2.self_attn.q_a_layernorm", eps = 1e-5);
    let l2_q_local = linear(l2_qn, weight = "model.layers.2.self_attn.q_b_proj", width = 1152, placement = "tp_rows");
    let l2_q = gather(l2_q_local);
    let l2_kv = linear(l2_an, weight = "model.layers.2.self_attn.kv_a_proj_with_mqa", width = 576, placement = "replicated");
    let l2_latent = slice(l2_kv, start = 0, width = 512);
    let l2_kr = slice(l2_kv, start = 512, width = 64);
    let l2_kc = mome(l2_latent, weight = "model.layers.2.self_attn.compresskv_conv", taps = 3);
    let l2_kn = norm(l2_kc, weight = "model.layers.2.self_attn.kv_a_layernorm", eps = 1e-5);
    let l2_rot = rope(l2_kr, theta = 6400000);
    let l2_key = concat(l2_kn, l2_rot);
    let l2_sink = sink_normalize(weight = "model.layers.2.self_attn", norm = "model.layers.2.self_attn.kv_a_layernorm", count = 128, latent = 512, rope = 64, eps = 1e-5);
    let l2_cache = cache_append(l2_key, l2_sink);
    let l2_query = mla_query(l2_q, weight = "model.layers.2.self_attn.kv_b_proj", theta = 6400000, heads = 48, nope = 128, rope = 64, latent = 512);
    let l2_att = latent_attention(l2_query, l2_cache, scale_dim = 192, window = 512, selection = "all_causal_within_window");
    let l2_value = mla_value(l2_att, weight = "model.layers.2.self_attn.kv_b_proj", heads = 48, latent = 512, value = 128);
    let l2_vg = gather(l2_value);
    let l2_oc = mome(l2_vg, weight = "model.layers.2.self_attn.o_conv", taps = 3);
    let l2_ao_local = linear(l2_oc, weight = "model.layers.2.self_attn.o_proj", width = 320, placement = "tp_rows");
    let l2_ao = gather(l2_ao_local);
    let l2_apn = norm(l2_ao, weight = "model.layers.2.post_attention_layernorm", eps = 1e-5);
    let l2_res = mhc_post(l2_hc, l2_apn);
    let l2_fhc = mhc_pre(l2_res, weight = "model.layers.2.mlp_mhc_module", streams = 4, sinkhorn = 20, eps = 1e-6);
    let l2_fin = mhc_input(l2_fhc);
    let l2_fn = norm(l2_fin, weight = "model.layers.2.pre_mlp_layernorm", eps = 1e-5);
    let l2_route = router(l2_fn, weight = "model.layers.2.mlp", experts = 256, topk = 8, scoring = "sigmoid_bias_group_topk", scale = 2.5);
    let l2_eg = expert_linear(l2_fn, l2_route, weight = "model.layers.2.mlp.experts.{expert}.gate_proj", width = 1024);
    let l2_eu = expert_linear(l2_fn, l2_route, weight = "model.layers.2.mlp.experts.{expert}.up_proj", width = 1024);
    let l2_ed = expert_swiglu_down(l2_eg, l2_eu, l2_route, weight = "model.layers.2.mlp.experts.{expert}.down_proj", width = 2560);
    let l2_er = expert_reduce(l2_ed, l2_route);
    let l2_sum = allreduce(l2_er);
    let l2_shared_gate_local = linear(l2_fn, weight = "model.layers.2.mlp.shared_experts.gate_proj", width = 128, placement = "tp_rows");
    let l2_shared_gate = gather(l2_shared_gate_local);
    let l2_shared_up_local = linear(l2_fn, weight = "model.layers.2.mlp.shared_experts.up_proj", width = 128, placement = "tp_rows");
    let l2_shared_up = gather(l2_shared_up_local);
    let l2_shared_act = swiglu(l2_shared_gate, l2_shared_up);
    let l2_shared_local = linear(l2_shared_act, weight = "model.layers.2.mlp.shared_experts.down_proj", width = 320, placement = "tp_rows");
    let l2_shared = gather(l2_shared_local);
    let l2_ff = add(l2_sum, l2_shared);
    let l2_fpn = norm(l2_ff, weight = "model.layers.2.post_mlp_layernorm", eps = 1e-5);
    let l2_post = mhc_post(l2_fhc, l2_fpn);
    let l2_out = optional_norm(l2_post, weight = "model.layers.2.block_post_layernorm", eps = 1e-5);

    // Layer 3: 256 experts, top 8, EP8 + shared expert.
    let l3_hc = mhc_pre(l2_out, weight = "model.layers.3.attn_mhc_module", streams = 4, sinkhorn = 20, eps = 1e-6);
    let l3_hin = mhc_input(l3_hc);
    let l3_an = norm(l3_hin, weight = "model.layers.3.input_layernorm", eps = 1e-5);
    let l3_qa = linear(l3_an, weight = "model.layers.3.self_attn.q_a_proj", width = 1024, placement = "replicated");
    let l3_qc = mome(l3_qa, weight = "model.layers.3.self_attn.qa_conv", taps = 3);
    let l3_qn = norm(l3_qc, weight = "model.layers.3.self_attn.q_a_layernorm", eps = 1e-5);
    let l3_q_local = linear(l3_qn, weight = "model.layers.3.self_attn.q_b_proj", width = 1152, placement = "tp_rows");
    let l3_q = gather(l3_q_local);
    let l3_kv = linear(l3_an, weight = "model.layers.3.self_attn.kv_a_proj_with_mqa", width = 576, placement = "replicated");
    let l3_latent = slice(l3_kv, start = 0, width = 512);
    let l3_kr = slice(l3_kv, start = 512, width = 64);
    let l3_kc = mome(l3_latent, weight = "model.layers.3.self_attn.compresskv_conv", taps = 3);
    let l3_kn = norm(l3_kc, weight = "model.layers.3.self_attn.kv_a_layernorm", eps = 1e-5);
    let l3_rot = rope(l3_kr, theta = 6400000);
    let l3_key = concat(l3_kn, l3_rot);
    let l3_sink = sink_normalize(weight = "model.layers.3.self_attn", norm = "model.layers.3.self_attn.kv_a_layernorm", count = 128, latent = 512, rope = 64, eps = 1e-5);
    let l3_cache = cache_append(l3_key, l3_sink);
    let l3_query = mla_query(l3_q, weight = "model.layers.3.self_attn.kv_b_proj", theta = 6400000, heads = 48, nope = 128, rope = 64, latent = 512);
    let l3_att = latent_attention(l3_query, l3_cache, scale_dim = 192, window = 2048, selection = "all_causal_within_window");
    let l3_value = mla_value(l3_att, weight = "model.layers.3.self_attn.kv_b_proj", heads = 48, latent = 512, value = 128);
    let l3_vg = gather(l3_value);
    let l3_oc = mome(l3_vg, weight = "model.layers.3.self_attn.o_conv", taps = 3);
    let l3_ao_local = linear(l3_oc, weight = "model.layers.3.self_attn.o_proj", width = 320, placement = "tp_rows");
    let l3_ao = gather(l3_ao_local);
    let l3_apn = norm(l3_ao, weight = "model.layers.3.post_attention_layernorm", eps = 1e-5);
    let l3_res = mhc_post(l3_hc, l3_apn);
    let l3_fhc = mhc_pre(l3_res, weight = "model.layers.3.mlp_mhc_module", streams = 4, sinkhorn = 20, eps = 1e-6);
    let l3_fin = mhc_input(l3_fhc);
    let l3_fn = norm(l3_fin, weight = "model.layers.3.pre_mlp_layernorm", eps = 1e-5);
    let l3_route = router(l3_fn, weight = "model.layers.3.mlp", experts = 256, topk = 8, scoring = "sigmoid_bias_group_topk", scale = 2.5);
    let l3_eg = expert_linear(l3_fn, l3_route, weight = "model.layers.3.mlp.experts.{expert}.gate_proj", width = 1024);
    let l3_eu = expert_linear(l3_fn, l3_route, weight = "model.layers.3.mlp.experts.{expert}.up_proj", width = 1024);
    let l3_ed = expert_swiglu_down(l3_eg, l3_eu, l3_route, weight = "model.layers.3.mlp.experts.{expert}.down_proj", width = 2560);
    let l3_er = expert_reduce(l3_ed, l3_route);
    let l3_sum = allreduce(l3_er);
    let l3_shared_gate_local = linear(l3_fn, weight = "model.layers.3.mlp.shared_experts.gate_proj", width = 128, placement = "tp_rows");
    let l3_shared_gate = gather(l3_shared_gate_local);
    let l3_shared_up_local = linear(l3_fn, weight = "model.layers.3.mlp.shared_experts.up_proj", width = 128, placement = "tp_rows");
    let l3_shared_up = gather(l3_shared_up_local);
    let l3_shared_act = swiglu(l3_shared_gate, l3_shared_up);
    let l3_shared_local = linear(l3_shared_act, weight = "model.layers.3.mlp.shared_experts.down_proj", width = 320, placement = "tp_rows");
    let l3_shared = gather(l3_shared_local);
    let l3_ff = add(l3_sum, l3_shared);
    let l3_fpn = norm(l3_ff, weight = "model.layers.3.post_mlp_layernorm", eps = 1e-5);
    let l3_post = mhc_post(l3_fhc, l3_fpn);
    let l3_out = optional_norm(l3_post, weight = "model.layers.3.block_post_layernorm", eps = 1e-5);

    // Layer 4: 256 experts, top 8, EP8 + shared expert.
    let l4_hc = mhc_pre(l3_out, weight = "model.layers.4.attn_mhc_module", streams = 4, sinkhorn = 20, eps = 1e-6);
    let l4_hin = mhc_input(l4_hc);
    let l4_an = norm(l4_hin, weight = "model.layers.4.input_layernorm", eps = 1e-5);
    let l4_qa = linear(l4_an, weight = "model.layers.4.self_attn.q_a_proj", width = 1024, placement = "replicated");
    let l4_qc = mome(l4_qa, weight = "model.layers.4.self_attn.qa_conv", taps = 3);
    let l4_qn = norm(l4_qc, weight = "model.layers.4.self_attn.q_a_layernorm", eps = 1e-5);
    let l4_q_local = linear(l4_qn, weight = "model.layers.4.self_attn.q_b_proj", width = 1152, placement = "tp_rows");
    let l4_q = gather(l4_q_local);
    let l4_kv = linear(l4_an, weight = "model.layers.4.self_attn.kv_a_proj_with_mqa", width = 576, placement = "replicated");
    let l4_latent = slice(l4_kv, start = 0, width = 512);
    let l4_kr = slice(l4_kv, start = 512, width = 64);
    let l4_kc = mome(l4_latent, weight = "model.layers.4.self_attn.compresskv_conv", taps = 3);
    let l4_kn = norm(l4_kc, weight = "model.layers.4.self_attn.kv_a_layernorm", eps = 1e-5);
    let l4_rot = rope(l4_kr, theta = 6400000);
    let l4_key = concat(l4_kn, l4_rot);
    let l4_sink = sink_normalize(weight = "model.layers.4.self_attn", norm = "model.layers.4.self_attn.kv_a_layernorm", count = 128, latent = 512, rope = 64, eps = 1e-5);
    let l4_cache = cache_append(l4_key, l4_sink);
    let l4_query = mla_query(l4_q, weight = "model.layers.4.self_attn.kv_b_proj", theta = 6400000, heads = 48, nope = 128, rope = 64, latent = 512);
    let l4_att = latent_attention(l4_query, l4_cache, scale_dim = 192, window = 512, selection = "all_causal_within_window");
    let l4_value = mla_value(l4_att, weight = "model.layers.4.self_attn.kv_b_proj", heads = 48, latent = 512, value = 128);
    let l4_vg = gather(l4_value);
    let l4_oc = mome(l4_vg, weight = "model.layers.4.self_attn.o_conv", taps = 3);
    let l4_ao_local = linear(l4_oc, weight = "model.layers.4.self_attn.o_proj", width = 320, placement = "tp_rows");
    let l4_ao = gather(l4_ao_local);
    let l4_apn = norm(l4_ao, weight = "model.layers.4.post_attention_layernorm", eps = 1e-5);
    let l4_res = mhc_post(l4_hc, l4_apn);
    let l4_fhc = mhc_pre(l4_res, weight = "model.layers.4.mlp_mhc_module", streams = 4, sinkhorn = 20, eps = 1e-6);
    let l4_fin = mhc_input(l4_fhc);
    let l4_fn = norm(l4_fin, weight = "model.layers.4.pre_mlp_layernorm", eps = 1e-5);
    let l4_route = router(l4_fn, weight = "model.layers.4.mlp", experts = 256, topk = 8, scoring = "sigmoid_bias_group_topk", scale = 2.5);
    let l4_eg = expert_linear(l4_fn, l4_route, weight = "model.layers.4.mlp.experts.{expert}.gate_proj", width = 1024);
    let l4_eu = expert_linear(l4_fn, l4_route, weight = "model.layers.4.mlp.experts.{expert}.up_proj", width = 1024);
    let l4_ed = expert_swiglu_down(l4_eg, l4_eu, l4_route, weight = "model.layers.4.mlp.experts.{expert}.down_proj", width = 2560);
    let l4_er = expert_reduce(l4_ed, l4_route);
    let l4_sum = allreduce(l4_er);
    let l4_shared_gate_local = linear(l4_fn, weight = "model.layers.4.mlp.shared_experts.gate_proj", width = 128, placement = "tp_rows");
    let l4_shared_gate = gather(l4_shared_gate_local);
    let l4_shared_up_local = linear(l4_fn, weight = "model.layers.4.mlp.shared_experts.up_proj", width = 128, placement = "tp_rows");
    let l4_shared_up = gather(l4_shared_up_local);
    let l4_shared_act = swiglu(l4_shared_gate, l4_shared_up);
    let l4_shared_local = linear(l4_shared_act, weight = "model.layers.4.mlp.shared_experts.down_proj", width = 320, placement = "tp_rows");
    let l4_shared = gather(l4_shared_local);
    let l4_ff = add(l4_sum, l4_shared);
