language inferfabric 1;

// DSL modules expand into the inspectable primitive execution graph.
// TP8/EP8 correctness backend: one sequence, exact causal candidates <=512.
module TPLinear(x, w, width) {
    let local = linear(x, weight = w, width = div(width, 8), placement = "tp_rows");
    let output = gather(local);
    yield output;
}

module PlacedLinear(x, w, width, parallel) {
    let output = choose(parallel, linear(x, weight = w, width = div(width, 8), placement = "tp_rows"),
                 linear(x, weight = w, width = width, placement = "replicated"));
    yield output;
}

module DenseFFN(x, w, intermediate, parallel) {
    let gate = PlacedLinear(x, w.gate_proj, intermediate, parallel);
    let up = PlacedLinear(x, w.up_proj, intermediate, parallel);
    let activated = swiglu(gate, up);
    let output = choose(parallel,
        allreduce(linear(activated, weight = w.down_proj, width = 2560, placement = "tp_columns")),
        linear(activated, weight = w.down_proj, width = 2560, placement = "replicated"));
    yield output;
}

module RoutedMoE(x, w) {
    let routes = router(x, weight = w, experts = 256, topk = 8,
                        scoring = "sigmoid_bias_group_topk", scale = 2.5);
    let expert = child(w.experts, "{expert}");
    let gate = expert_linear(x, routes, weight = expert.gate_proj, width = 1024);
    let up = expert_linear(x, routes, weight = expert.up_proj, width = 1024);
    let down = expert_swiglu_down(gate, up, routes, weight = expert.down_proj, width = 2560);
    let local = expert_reduce(down, routes);
    let routed = allreduce(local);
    let shared = DenseFFN(x, w.shared_experts, 1024, false);
    let output = add(routed, shared);
    yield output;
}

module MLAAttention(x, w, window) {
    let qa = linear(x, weight = w.q_a_proj, width = 1024, placement = "replicated");
    let qc = mome(qa, weight = w.qa_conv, taps = 3);
    let qn = norm(qc, weight = w.q_a_layernorm, eps = 1e-5);
    let q = linear(qn, weight = w.q_b_proj, width = 1152, placement = "tp_rows");

    let kv = linear(x, weight = w.kv_a_proj_with_mqa, width = 576, placement = "replicated");
    let latent = slice(kv, start = 0, width = 512);
    let kr = slice(kv, start = 512, width = 64);
    let kc = mome(latent, weight = w.compresskv_conv, taps = 3);
    let kn = norm(kc, weight = w.kv_a_layernorm, eps = 1e-5);
    let rot = rope(kr, theta = 6400000);
    let key = concat(kn, rot);

    let sinks = sink_normalize(weight = w, norm = w.kv_a_layernorm,
                               count = 128, latent = 512, rope = 64, eps = 1e-5);
    let cache = cache_append(key, sinks);
    let query = mla_query(q, weight = w.kv_b_proj, theta = 6400000,
                          heads = 48, nope = 128, rope = 64, latent = 512, input_layout = "rank_local");
    let attended = latent_attention(query, cache, scale_dim = 192,
                                    window = window, selection = "all_causal_within_window");
    let value = mla_value(attended, weight = w.kv_b_proj, heads = 48, latent = 512, value = 128);
    let oc = mome(value, weight = w.o_conv, taps = 3, placement = "tp_channels");
    let partial = linear(oc, weight = w.o_proj, width = 2560, placement = "tp_columns");
    let output = allreduce(partial);
    yield output;
}

module DecoderBlock(x, w, index, window) {
    let attn_hc = mhc_pre(x, weight = w.attn_mhc_module, streams = 4, sinkhorn = 20, eps = 1e-6);
    let attn_input = mhc_input(attn_hc);
    let attn_norm = norm(attn_input, weight = w.input_layernorm, eps = 1e-5);
    let attention = MLAAttention(attn_norm, w.self_attn, window);
    let attn_post = norm(attention, weight = w.post_attention_layernorm, eps = 1e-5);
    let residual = mhc_post(attn_hc, attn_post);

    let ffn_hc = mhc_pre(residual, weight = w.mlp_mhc_module, streams = 4, sinkhorn = 20, eps = 1e-6);
    let ffn_input = mhc_input(ffn_hc);
    let ffn_norm = norm(ffn_input, weight = w.pre_mlp_layernorm, eps = 1e-5);
    let ffn = choose(lt(index, 2), DenseFFN(ffn_norm, w.mlp, 9216, true), RoutedMoE(ffn_norm, w.mlp));
    let ffn_post = norm(ffn, weight = w.post_mlp_layernorm, eps = 1e-5);
    let post = mhc_post(ffn_hc, ffn_post);
    let output = optional_norm(post, weight = w.block_post_layernorm, eps = 1e-5);
    yield output;
}

model OpenPangu92B {
    context = 512;
    eos = 148902;
    let w = weights("model");
    let embedded = embedding(weight = w.embed_tokens, width = 2560, vocab = 151552);
    let streams = repeat(embedded, count = 4);

    let hidden = fold i in range(0, 46) carry(x = streams) {
        let window = choose(eq(mod(i, 3), 0), 2048, 512);
        let block = DecoderBlock(x, child(w.layers, i), i, window);
        yield block;
    };

    let merge = mhc_merge(hidden, weight = w.merge_mhc_module, streams = 4, sinkhorn = 20, eps = 1e-6);
    let merged = mhc_input(merge);
    let normalized = norm(merged, weight = w.norm, eps = 1e-5);
    let logits = TPLinear(normalized, weights("lm_head"), 151552);
    yield logits;
}

plan TP8EP8 for OpenPangu92B {
    target = ascend_token_v1;
    tp = 8;
    ep = 8;
    devices = [0, 1, 2, 3, 4, 5, 6, 7];
    max_num_seqs = 1;
    max_num_batched_tokens = 1;
    max_model_len = 512;
}
