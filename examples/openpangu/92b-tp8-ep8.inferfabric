}

plan TP8EP8 for OpenPangu92B {
    target = ascend_token_v1;
    tp = 8;
    ep = 8;
    devices = [0, 1, 2, 3, 4, 5, 6, 7];
    max_num_seqs = 1;
    max_num_batched_tokens = 1;
    max_model_len = 512;
}
